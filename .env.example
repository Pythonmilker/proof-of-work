# Copy to .env.local and fill in whatever you have. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# NONE OF THIS IS REQUIRED. With an empty file the app runs end to end: deterministic extraction,
# lexical matching, the local JSON store seeded from src/store/seed.ts. That is a supported way to run
# it, not a degraded one, and the header says which mode you are in either way.
#
# Run `pnpm doctor` after editing. It reports each credential separately, and a credential that is set
# but rejected is reported as rejected — never quietly folded back into demo mode.


# ── Models ────────────────────────────────────────────────────────────────────────────────────────
# Turns on real extraction (claude-haiku-4.5), real JD parsing (gpt-4o-mini), embeddings-backed
# retrieval, and generated rationales. https://openrouter.ai/keys
#
# The key is read by the Vite dev server and stays in the Node process. It is never sent to the browser
# and never ends up in a build — `pnpm build` produces a static site that runs the deterministic path.
#
# Set a spend cap on the key. A demo key with no ceiling is a bad idea regardless of how careful you are.
OPENROUTER_API_KEY=


# ── Airtable ──────────────────────────────────────────────────────────────────────────────────────
# Swaps the local store for a real base. Independent of the model key — either, both, or neither works.
#
# Create a token at https://airtable.com/create/tokens with scopes:
#   schema.bases:read, schema.bases:write, data.records:read, data.records:write
# and access to the workspace you want the base in.
AIRTABLE_PAT=

# Needed only for the first `pnpm airtable:provision`. Airtable has no API for listing workspaces, so
# read it off the URL: open airtable.com, click the workspace, copy the wsp... segment.
AIRTABLE_WORKSPACE_ID=

# Written for you by `pnpm airtable:provision`. Set it by hand only to point at an existing base.
AIRTABLE_BASE_ID=


# ── n8n ───────────────────────────────────────────────────────────────────────────────────────────
# Moves the pipeline out of this repo entirely. Import n8n/*.json, activate the workflows, and paste the
# extract webhook URL here — the React app talks to the same contract and nothing in the UI changes.
#
#   VITE_PIPELINE_ENDPOINT=https://your-n8n.example.com/webhook/proof-of-work/extract
VITE_PIPELINE_ENDPOINT=
